# Copy to server/.env for local runs (never commit secrets).
PORT=8080
BMRG_DATA_ROOT=
BMRG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Prefer Railway plugin refs in production:
# BMRG_DATABASE_URL=${{Postgres.DATABASE_URL}}
# BMRG_REDIS_URL=${{Redis.REDIS_URL}}
BMRG_DATABASE_URL=postgresql+psycopg2://bmrg:bmrg@localhost:54329/bmrg
BMRG_REDIS_URL=redis://localhost:6379/0
